#!/bin/bash
# Script interativo para configurar rede com net-tools

echo "==== Configuração de Rede (net-tools) ===="

# Mostrar interfaces disponíveis
echo "Interfaces de rede detectadas:"
ifconfig -a | grep -o "^[a-z0-9]*"
echo "--------------------------------------"

# Perguntar interface
read -p "Digite o nome da interface (ex: enp0s3): " IFACE

# Perguntar IP e máscara
read -p "Digite o endereço IP (ex: 192.168.22.106): " IP
read -p "Digite a máscara de rede (ex: 255.255.255.128): " NETMASK

# Perguntar gateway
read -p "Digite o gateway (ex: 192.168.22.126): " GATEWAY

# Perguntar DNS
read -p "Digite o DNS primário (ex: 8.8.8.8): " DNS1
read -p "Digite o DNS secundário (ex: 8.8.4.4): " DNS2

echo "--------------------------------------"
echo "Aplicando configurações..."

# Derrubar interface
sudo ifconfig $IFACE down

# Configurar IP e máscara
sudo ifconfig $IFACE $IP netmask $NETMASK up

# Adicionar rota padrão
route add default gw $GATEWAY $IFACE

# Configurar DNS
echo "nameserver $DNS1" > /etc/resolv.conf
echo "nameserver $DNS2" >> /etc/resolv.conf

echo "--------------------------------------"
echo "Configuração aplicada com sucesso!"
echo "Testando conectividade com ping no $DNS1 ..."
ping -c 4 $DNS1
